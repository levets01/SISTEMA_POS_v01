{
  "name": "puesto-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Punto de venta local para Windows",
  "author": "Puesto POS",
  "main": "build/main.cjs",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "serve": "node build/service.cjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:win": "node scripts/build.mjs && node scripts/package.mjs",
    "release:win": "node scripts/build.mjs && node scripts/package.mjs --release"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node-forge": "^1.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/semver": "^7.7.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3",
    "vitest": "5.1.1",
    "vite": "8.3.8",
    "tsx": "4.23.15",
    "swagger-ui-dist": "5.35.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "app-builder-bin"
    ]
  }
}
