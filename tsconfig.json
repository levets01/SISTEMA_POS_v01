{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@puesto/shared": [
        "./packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "*.config.ts"
  ]
}
